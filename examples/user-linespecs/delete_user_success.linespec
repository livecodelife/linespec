TEST delete_user_success

RECEIVE HTTP:DELETE /api/v1/users/42
HEADERS
  Authorization: Bearer ${AUTH_TOKEN}

EXPECT READ:MYSQL users
USING_SQL """
SELECT users.* FROM `users` WHERE `users`.`token` = '${AUTH_TOKEN}' LIMIT 1
"""
RETURNS {{payloads/user_response.json}}

EXPECT READ:MYSQL users
USING_SQL """
SELECT users.* FROM `users` WHERE `users`.`id` = 42 LIMIT 1
"""
RETURNS {{payloads/user_response.json}}

EXPECT WRITE:MYSQL users
WITH {{payloads/user_response.json}}

RESPOND HTTP:204
