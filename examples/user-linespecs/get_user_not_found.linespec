TEST get_user_not_found

RECEIVE HTTP:GET /api/v1/users/999
HEADERS
  Authorization: Bearer ${AUTH_TOKEN}

EXPECT READ:MYSQL users
USING_SQL """
SELECT users.* FROM `users` WHERE `users`.`token` = '${AUTH_TOKEN}' LIMIT 1
"""
RETURNS {{payloads/user_response.json}}

EXPECT READ:MYSQL users
USING_SQL """
SELECT users.* FROM `users` WHERE `users`.`id` = 999 LIMIT 1
"""
RETURNS EMPTY

RESPOND HTTP:404
WITH {{payloads/user_not_found_error.json}}
