FROM golang:1.23-alpine AS builder
ENV GOTOOLCHAIN=auto
# cmd/linespec pulls in go-tree-sitter (via pkg/discover), a cgo package, so the
# build needs a C toolchain and CGO enabled. Without them the cgo bindings that
# define Node are excluded and the build fails with "undefined: Node". The
# legacy `-tags beta` is dropped: nothing gates on it after the Cobra collapse,
# and the default build is the unified superset.
RUN apk --no-cache add build-base
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# The -X target mirrors the Makefile's LDFLAGS so the image reports the real
# release instead of the ldflag-less default "vdev" (prov-2026-b9339a5a). It
# points at pkg/buildinfo, the single home for the injected version
# (prov-2026-f57f1570).
RUN CGO_ENABLED=1 go build -ldflags "-s -w -X github.com/livecodelife/linespec/v3/pkg/buildinfo.Version=$(cat VERSION)" -o linespec ./cmd/linespec

FROM alpine:latest
# libstdc++/libgcc back the cgo (go-tree-sitter) runtime dependencies.
RUN apk --no-cache add ca-certificates libstdc++
WORKDIR /app
COPY --from=builder /app/linespec /app/linespec
ENTRYPOINT ["/app/linespec"]
